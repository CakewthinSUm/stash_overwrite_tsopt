    interval: 86400
  # 苹果服务：引用 CakewthinSUm/Shadowrocket-Rules 的 Apple.list（含 USER-AGENT / IP 段，Stash 支持）
  rp-Apple:
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/CakewthinSUm/Shadowrocket-Rules/refs/heads/main/Apple.list
    interval: 86400
  # 域名部分仍用 blackmatrix7 Apple_Domain.yaml（Clash domain 格式，1550 条）
  rp-AppleDomain:
    behavior: domain
    format: yaml
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Apple/Apple_Domain.yaml
    interval: 86400
