# ============================================================
#  小火箭逻辑完整迁移 · Stash 覆写 (.stoverride)
#  基础配置：机场 Clash 订阅（提供 63 节点）
#  36 组结构 + 25 个精选规则集（Apple 部分用 Shadowrocket-Rules 的 Apple.list + blackmatrix7 域名集）
#  Stash 5.1 beta+（smart 组为 5.1 新增，5.0 及以下会加载失败）；规则集全部实测 HTTP 200
# ============================================================
name: 小火箭逻辑迁移
desc: |-
  完整搬小火箭 34 组分流逻辑；地区组 smart 智能选路（需 Stash 5.1 beta+）
  应用组默认手动选择；精选规则集控制内存占用

proxies:
  - name: Tailscale
    type: tailscale
    hostname: iphone-stash
    # 延迟测试：直连 Sunshine 主机的 HTTP 端口(47989)，Stash 代理列表里就能看到真实延迟
    # 直连一般 20-40ms；若显示 100ms+ 基本就是走了 DERP 中继
    benchmark-url: http://100.124.98.100:47989
    benchmark-timeout: 5
    # direct-peer-udp 只在配置了 dialer-proxy 时才生效；本配置不设 dialer-proxy，
    # 让 Tailscale 直接用本地网络打洞。以后若给这个节点加 dialer-proxy，记得同时打开它。
    # direct-peer-udp: true

rule-providers:
  rp-Telegram:
    behavior: classical
    format: yaml
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Telegram/Telegram.yaml
    interval: 86400
  rp-Twitter:
    behavior: classical
    format: yaml
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Twitter/Twitter.yaml
