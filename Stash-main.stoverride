# ============================================================
#  Stash 分流覆写 (.stoverride) · Tailscale 优化版
#  基础配置：机场 Clash 订阅（提供节点池）
#  35 个策略组；应用分流使用 Stash 内置 GEOSITE，仅 Apple.list 与 Steam CDN 为远程规则集
#  Stash 5.1 beta+（smart 组为 5.1 新增，5.0 及以下会加载失败）
# ============================================================
name: Stash 分流覆写 · Tailscale 优化版
icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Qure.png
desc: |-
  35 组分流，地区组 smart 智能选路（需 Stash 5.1 beta+）。
  内置 Tailscale 直连访问，应用分流使用内置 GEOSITE，Steam CDN 直连。

proxies:
  - name: Tailscale
    type: tailscale
    hostname: iphone-stash
    # 延迟测试：直连 Sunshine 主机的 HTTP 端口(47989)，Stash 代理列表里就能看到真实延迟
    # 直连一般 20-40ms；若显示 100ms+ 基本就是走了 DERP 中继
    benchmark-url: http://100.124.98.100:47989
    benchmark-timeout: 5
    # direct-peer-udp 只在配置了 dialer-proxy 时才生效；本配置不设 dialer-proxy，
    # 让 Tailscale 直接用本地网络打洞。以后若给这个节点加 dialer-proxy，记得同时打开它。
    # direct-peer-udp: true

rule-providers: #!replace
  # 苹果 USER-AGENT / IP 补充（上游活跃维护）
  rp-Apple:
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/LingJingMaster/Shadowrocket-Rules/refs/heads/main/Apple.list
    interval: 86400
  # Steam 下载 CDN 直连（上游活跃维护），必须优先于 steam 规则
  rp-SteamCDN:
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/Aethersailor/Custom_OpenClash_Rules/refs/heads/main/rule/Steam_CDN.list
    interval: 86400

proxy-groups: #!replace
  # Tailscale 专用选择组：可选择走 Tailnet 或直连
  - name: Tailscale访问
    icon: https://tailscale.com/favicon.png
    type: select
    proxies:
      - Tailscale
      - DIRECT
  - name: 香港节点
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Hong_Kong.png
    type: smart
    include-all: true
    filter: '(?i)🇭🇰|Hong Kong|HongKong|香港|\bHK'
  - name: 台湾节点
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Taiwan.png
    type: smart
    include-all: true
    filter: '(?i)🇹🇼|Taiwan|Taipei|台湾|\bTW'
  - name: 新加坡节点
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Singapore.png
    type: smart
    include-all: true
    filter: '(?i)🇸🇬|Singapore|新加坡|\bSG'
  - name: 日本节点
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Japan.png
    type: smart
    include-all: true
    filter: '(?i)🇯🇵|Japan|日本|\bJP'
  - name: 美国节点
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/US.png
    type: smart
    include-all: true
    filter: '(?i)🇺🇸|United States|美国|\bUS'
  - name: 韩国节点
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Korea.png
    type: smart
    include-all: true
    filter: '(?i)🇰🇷|Korea|韩国|\bKR'
  # 兜住没被上面地区组匹配到的节点；顺带排除 Tailscale 节点和机场的 info 假节点
  - name: 其他地区
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Global.png
    type: smart
    include-all: true
    exclude-filter: '(?i)🇭🇰|Hong Kong|HongKong|香港|\bHK|🇹🇼|Taiwan|Taipei|台湾|\bTW|🇸🇬|Singapore|新加坡|\bSG|🇯🇵|Japan|日本|\bJP|🇺🇸|United States|美国|\bUS|🇰🇷|Korea|韩国|\bKR|TS-内网|Tailscale|剩余|流量|到期|过期|套餐|重置|官网|客服|订阅|Traffic|Expire'
  - name: 自动选择
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Auto.png
    type: smart
    include-all: true
    exclude-filter: '(?i)Tailscale|TS-内网|剩余|流量|到期|过期|套餐|重置|官网|客服|订阅|Traffic|Expire'
  - name: 手动选择
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Fries.png
    type: select
    proxies:
      - 香港节点
      - 美国节点
      - 新加坡节点
      - 日本节点
      - 台湾节点
      - 韩国节点
      - 其他地区
      - 自动选择
      - DIRECT
  - name: 即时通讯
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Telegram.png
    type: select
    proxies: &common
      - 手动选择
      - 香港节点
      - 美国节点
      - 新加坡节点
      - 日本节点
      - 台湾节点
      - 自动选择
      - DIRECT
  - name: 社交媒体
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Twitter.png
    type: select
    proxies: *common
  - name: GitHub
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/GitHub.png
    type: select
    proxies: *common
  - name: AI服务
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/ChatGPT.png
    type: select
    proxies:
      - 新加坡节点
      - 手动选择
      - 香港节点
      - 美国节点
      - 日本节点
      - 台湾节点
      - 自动选择
      - DIRECT
  - name: TikTok
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/TikTok.png
    type: select
    proxies: *common
  - name: AppleTV+
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Apple.png
    type: select
    proxies: *common
  - name: YouTube
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png
    type: select
    proxies: *common
  - name: Netflix
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Netflix.png
    type: select
    proxies: *common
  - name: DisneyPlus
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Disney.png
    type: select
    proxies: *common
  - name: HBO
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/HBO.png
    type: select
    proxies: *common
  - name: PrimeVideo
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Netflix.png
    type: select
    proxies: *common
  - name: Emby
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Emby.png
    type: select
    proxies: *common
  - name: Spotify
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Spotify.png
    type: select
    proxies: *common
  - name: Bahamut
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Bahamut.png
    type: select
    proxies:
      - 台湾节点
      - 手动选择
      - 香港节点
      - 美国节点
      - 新加坡节点
      - 日本节点
      - 自动选择
      - DIRECT
  - name: 国外媒体
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/ForeignMedia.png
    type: select
    proxies: *common
  - name: 国外电商
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Amazon.png
    type: select
    proxies: *common
  - name: PayPal
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/PayPal.png
    type: select
    proxies: *common
  - name: 谷歌服务
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Google.png
    type: select
    proxies: *common
  - name: 苹果服务
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Apple.png
    type: select
    proxies:
      - DIRECT
      - 手动选择
      - 香港节点
      - 美国节点
      - 新加坡节点
      - 日本节点
      - 台湾节点
      - 自动选择
  - name: 微软服务
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Microsoft.png
    type: select
    proxies: *common
  - name: 游戏平台
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Game.png
    type: select
    proxies: *common
  - name: Steam
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Steam.png
    type: select
    proxies: *common
  - name: 测速工具
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Speedtest.png
    type: select
    proxies: *common
  - name: 漏网之鱼
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Direct.png
    type: select
    proxies:
      - 手动选择
      - 香港节点
      - 美国节点
      - 新加坡节点
      - 日本节点
      - 台湾节点
      - 韩国节点
      - 其他地区
      - 自动选择
      - DIRECT
  - name: 苹果推送
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Apple.png
    type: select
    proxies:
      - 自动选择
      - 手动选择
      - 香港节点
      - 美国节点
      - 新加坡节点
      - 日本节点
      - 台湾节点
      - 韩国节点
      - DIRECT

rules: #!replace
  # 1. Tailscale：Tailnet 域名及 IPv4/IPv6 地址走专用选择组
  #    （Stash iOS 3.6+ 会自动接管 MagicDNS 与 100.64/10，这几条是低版本/兜底用）
  - DOMAIN-SUFFIX,ts.net,Tailscale访问
  - IP-CIDR,100.64.0.0/10,Tailscale访问,no-resolve
  - IP-CIDR6,fd7a:115c:a1e0::/48,Tailscale访问,no-resolve
  # 2. APNs（按 Stash 官方 FAQ：推送走代理；域名 + 关键词 + IP 段）
  - DOMAIN-SUFFIX,push.apple.com,苹果推送
  - DOMAIN-SUFFIX,push.apple.com.cn,苹果推送
  - DOMAIN-KEYWORD,courier.push,苹果推送
  - DOMAIN-SUFFIX,akadns.net,苹果推送
  - DOMAIN-KEYWORD,apple.com.edgekey.net,苹果推送
  - DST-PORT,5223,苹果推送
  # Apple 官方 APNs IP 段（推送走这些 IP，光靠域名匹配不到）
  - IP-CIDR,17.249.0.0/16,苹果推送,no-resolve
  - IP-CIDR,17.252.0.0/16,苹果推送,no-resolve
  - IP-CIDR,17.57.144.0/22,苹果推送,no-resolve
  - IP-CIDR,17.188.128.0/18,苹果推送,no-resolve
  - IP-CIDR,17.188.20.0/23,苹果推送,no-resolve
  - IP-CIDR6,2620:149:a44::/48,苹果推送,no-resolve
  - IP-CIDR6,2403:300:a42::/48,苹果推送,no-resolve
  - IP-CIDR6,2403:300:a51::/48,苹果推送,no-resolve
  - IP-CIDR6,2a01:b740:a42::/48,苹果推送,no-resolve
  # 3. 直连：自建/UU
  - DOMAIN-SUFFIX,mytunnel.org,DIRECT
  - DOMAIN-SUFFIX,uu.163.com,DIRECT
  - DOMAIN-SUFFIX,netease.com,DIRECT
  - DST-PORT,3478,DIRECT
  # 4. 应用分流规则集（精选）
  # 应用分流：全部改用 Stash 内置 GEOSITE（随内核更新，不依赖第三方 URL）
  - GEOSITE,telegram,即时通讯
  - GEOSITE,twitter,社交媒体
  - GEOSITE,facebook,社交媒体
  - GEOSITE,instagram,社交媒体
  - GEOSITE,github,GitHub
  - GEOSITE,openai,AI服务
  - GEOSITE,anthropic,AI服务
  - GEOSITE,category-ai-!cn,AI服务
  - GEOSITE,google-gemini,AI服务
  - GEOSITE,youtube,YouTube
  - GEOSITE,apple-tvplus,AppleTV+
  - GEOSITE,paypal,PayPal
  - GEOSITE,apple,苹果服务
  - GEOSITE,microsoft,微软服务
  - GEOSITE,google,谷歌服务
  - GEOSITE,tiktok,TikTok
  - GEOSITE,netflix,Netflix
  - GEOSITE,disney,DisneyPlus
  - GEOSITE,hbo,HBO
  - GEOSITE,primevideo,PrimeVideo
  - GEOSITE,category-emby,Emby
  - GEOSITE,spotify,Spotify
  - GEOSITE,bahamut,Bahamut
  - GEOSITE,category-speedtest,测速工具
  # Steam 下载 CDN 直连：必须优先于 Steam/游戏平台规则，避免下载流量走代理
  - RULE-SET,rp-SteamCDN,DIRECT
  # 补齐小火箭分组逻辑：Steam / 游戏平台 / 国外媒体 分别由 GEOSITE 分流
  - GEOSITE,steam,Steam
  - GEOSITE,category-games,游戏平台
  - GEOSITE,category-entertainment,国外媒体
  - GEOSITE,category-ecommerce,国外电商

  # 兜底：国内直连，其余走漏网之鱼
  - GEOIP,CN,DIRECT
  - MATCH,漏网之鱼
