    interval: 86400

proxy-groups: #!replace
  # Tailscale 专用选择组：可选择走 Tailnet 或直连
  - name: Tailscale访问
    type: select
    proxies:
      - Tailscale
      - DIRECT
  - name: 香港节点
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Hong_Kong.png
    type: smart
    include-all: true
    filter: '🇭🇰|Hong Kong|HongKong|香港|\bHK'
  - name: 台湾节点
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Taiwan.png
    type: smart
    include-all: true
    filter: '🇹🇼|Taiwan|Taipei|台湾|\bTW'
  - name: 新加坡节点
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Singapore.png
    type: smart
    include-all: true
    filter: '🇸🇬|Singapore|新加坡|\bSG'
  - name: 日本节点
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Japan.png
    type: smart
    include-all: true
    filter: '🇯🇵|Japan|日本|\bJP'
  - name: 美国节点
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/US.png
    type: smart
    include-all: true
    filter: '🇺🇸|United States|美国|\bUS'
  - name: 韩国节点
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Korea.png
    type: smart
    include-all: true
    filter: '🇰🇷|Korea|韩国|\bKR'
  # 兜住没被上面地区组匹配到的节点；顺带排除 Tailscale 节点和机场的 info 假节点
  - name: 其他地区
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Global.png
    type: smart
    include-all: true
    exclude-filter: '🇭🇰|Hong Kong|HongKong|香港|\bHK|🇹🇼|Taiwan|Taipei|台湾|\bTW|🇸🇬|Singapore|新加坡|\bSG|🇯🇵|Japan|日本|\bJP|🇺🇸|United States|美国|\bUS|🇰🇷|Korea|韩国|\bKR|TS-内网|剩余|流量|到期|过期|套餐|重置|官网|客服|订阅|Traffic|Expire'
  - name: 自动选择
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Auto.png
    type: smart
    include-all: true
    filter: '🇭🇰|🇹🇼|🇸🇬|🇯🇵|🇺🇸|🇰🇷'
  - name: 手动选择
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Proxy.png
    type: select
    proxies:
      - 香港节点
      - 美国节点
      - 新加坡节点
      - 日本节点
      - 台湾节点
      - 韩国节点
